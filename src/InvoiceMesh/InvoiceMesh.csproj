<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>InvoiceMesh</RootNamespace>
    <AssemblyName>InvoiceMesh</AssemblyName>
    <UserSecretsId>invoicemesh</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <!-- Pinned to the same version as the design-time package, so the tests resolve one consistent EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Draws the QR code of the authenticator app set-up as SVG (pure managed, no external service) -->
    <PackageReference Include="QRCoder" Version="1.*" />
    <!-- Draws the readable view and the validation report as PDF (community licence, set in Program.cs) -->
    <PackageReference Include="QuestPDF" Version="2025.*" />
    <!-- SMB client: the files and the backups on a NAS -->
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvoiceMesh.Core\InvoiceMesh.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample documents of "Beispieldaten" (Einstellungen > System). -->
    <EmbeddedResource Include="Demo\*" LogicalName="Demo.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InvoiceMesh.Tests" />
  </ItemGroup>

</Project>
