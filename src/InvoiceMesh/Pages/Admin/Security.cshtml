@page
@model InvoiceMesh.Pages.Admin.SecurityModel

<form class="mat-form" method="post" novalidate>
    <im-summary />
    <im-tabs id="security" label="Sicherheit">
        <im-tab id="signin" title="Anmeldung" icon="shield">
            <im-card>
                <div class="mat-form__grid">
                    <im-input for="Input.SessionDays" label="Sitzung bleibt gültig für Tage" type="number" min="1" max="365" hint="Danach muss man sich wieder anmelden. Die Sitzungen sind in der Datenbank gespeichert und überstehen einen Neustart." />
                    <im-switch for="Input.RequireTotpForAdmins" label="Administratoren müssen die Zwei-Faktor-Anmeldung einrichten" full="true" />
                </div>
            </im-card>
        </im-tab>

        <im-tab id="links" title="Links" icon="link">
            <im-card>
                <div class="mat-form__grid">
                    <im-input for="Input.ShareLinkDays" label="Freigabe-Link gilt für Tage" type="number" min="1" max="365" hint="Der Vorschlag beim Erstellen eines Links. Jeder Link hat sein eigenes Ablaufdatum." />
                </div>
            </im-card>
        </im-tab>

        <im-tab id="address" title="Adresse" icon="globe">
            <im-card>
                <div class="mat-form__grid">
                    <im-input for="Input.PublicUrl" label="Öffentliche Adresse" type="url" full="true" hint="@(Model.UrlFromEnvironment ? "Wird gerade von der Umgebungsvariable INVOICEMESH__Server__PublicUrl bestimmt." : $"Steht in den Links, die du weitergibst, zum Beispiel https://projekte.example.de. Leer: die Adresse der Anfrage (jetzt {Model.CurrentBase}).")" />
                    <im-switch for="Input.ForceSecureCookie" label="Cookie immer als „Secure“ markieren (wenn die Seite über HTTPS erreichbar ist)" full="true" />
                </div>
            </im-card>
        </im-tab>
    </im-tabs>
    <im-buttons back-href="/" />
</form>
