@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model InvoiceMesh.Pages.Account.ProfileModel
@{
    ViewData["Width"] = "narrow";
    var themes = new List<SelectListItem> { new("System", "system"), new("Hell", "light"), new("Dunkel", "dark") };
}

<form class="mat-form" method="post" asp-page-handler="Profile" novalidate>
    <im-card title="Profil" icon="user">
        <im-summary />
        <div class="mat-form__grid">
            <im-input for="Profile.DisplayName" label="Name" autocomplete="name" />
            <im-input for="Profile.Phone" label="Telefon" type="tel" autocomplete="tel" />
            <div class="mat-field">
                <span class="mat-label">E-Mail-Adresse</span>
                <input class="mat-input" value="@Model.Email" disabled />
                <span class="mat-hint">Die Adresse ändert die Administration.</span>
            </div>
            <im-select for="Profile.Theme" label="Darstellung" items="themes" hint="Der Knopf unten im Menü stellt das Gleiche ein." />
        </div>
    </im-card>
    <im-buttons back-href="/" />
</form>

<form class="mat-form" method="post" asp-page-handler="Password" novalidate>
    <im-card title="@(Model.HasPassword ? "Passwort ändern" : "Passwort festlegen")" icon="lock">
        @if (!Model.HasPassword)
        {
            <p class="mat-muted">Du meldest dich bisher mit einem Code per E-Mail an. Mit einem Passwort kannst du dich auch direkt anmelden.</p>
        }
        <div class="mat-form__grid">
            @if (Model.HasPassword)
            {
                <im-input for="Password.Current" label="Aktuelles Passwort" type="password" autocomplete="current-password" full="true" required="true" />
            }
            <im-input for="Password.New" label="Neues Passwort" type="password" autocomplete="new-password" hint="Mindestens 10 Zeichen." />
            <im-input for="Password.Repeat" label="Neues Passwort wiederholen" type="password" autocomplete="new-password" />
        </div>
    </im-card>
    <im-buttons save-text="Passwort speichern" save-icon="key" back-href="/" />
</form>
