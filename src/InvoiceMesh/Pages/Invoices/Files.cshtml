@page
@model InvoiceMesh.Pages.Invoices.FilesModel
@{
    var doc = Model.Doc;
}

@functions {
    // The preview action of a row: shows the file below the table (or opens the page that shows it).
    private void Preview(string key, string href, string label = "Vorschau")
    {
        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="@href" aria-label="@label" data-tip="@label" aria-current="@(Model.IsShown(key) ? "true" : null)">@Ui.Icon("eye")</a>
    }
}

<partial name="_LinkTabs" model="Model.Tabs" />

<div class="mat-table-wrap">
    <table class="mat-table">
        <caption class="mat-sr-only">Dateien des Belegs</caption>
        <thead><tr><th scope="col">Datei</th><th scope="col" class="mat-hide-sm">Art</th><th scope="col" class="mat-hide-sm">Erzeugt</th><th scope="col">Stand</th><th scope="col"><span class="mat-sr-only">Aktionen</span></th></tr></thead>
        <tbody>
            <tr>
                <td data-label="Datei">@Ui.NameWithSub("Originaldatei", $"/Invoices/Original?id={doc.Id}", $"{doc.FileName} · {Fmt.FileSize(doc.SizeBytes)}")</td>
                <td data-label="Art" class="mat-hide-sm">Original, unverändert</td>
                <td data-label="Erzeugt" class="mat-hide-sm">@Fmt.Moment(doc.ReceivedDate)</td>
                <td data-label="Stand">@Ui.Pill("Original", "plain", "lock")</td>
                <td class="mat-table__cell-actions"><div class="mat-table__actions">
                    @{ Preview("original", $"/Invoices/Original?id={doc.Id}", "Ansehen"); }
                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/files/@doc.Id/original?download=1" aria-label="Herunterladen" data-tip="Herunterladen">@Ui.Icon("download")</a>
                </div></td>
            </tr>
            @if (doc.EmbeddedXmlFile is { } xml)
            {
                <tr class="@(Model.IsShown("embedded") ? "is-selected" : "")">
                    <td data-label="Datei">@Ui.NameWithSub("Eingebettetes XML", Model.PreviewUrl("embedded"), $"{xml.FileName} · {Fmt.FileSize(xml.SizeBytes)}")</td>
                    <td data-label="Art" class="mat-hide-sm">Aus dem hybriden PDF, unverändert</td>
                    <td data-label="Erzeugt" class="mat-hide-sm">@Fmt.Moment(xml.CreateDate)</td>
                    <td data-label="Stand">@Ui.Pill("Original", "plain", "lock")</td>
                    <td class="mat-table__cell-actions"><div class="mat-table__actions">
                        @{ Preview("embedded", Model.PreviewUrl("embedded")); }
                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/files/@doc.Id/embedded" aria-label="Herunterladen" data-tip="Herunterladen">@Ui.Icon("download")</a>
                    </div></td>
                </tr>
            }
            @if (Model.Ctx.Extraction is not null)
            {
                <tr class="@(Model.IsShown("extracted") ? "is-selected" : "")">
                    <td data-label="Datei">@Ui.NameWithSub("Ausgelesene Daten", Model.PreviewUrl("extracted"), "Format, Geschäftsbegriffe (ausgelesen und korrigiert), Rohdaten")</td>
                    <td data-label="Art" class="mat-hide-sm">JSON</td>
                    <td data-label="Erzeugt" class="mat-hide-sm">@Fmt.Moment(Model.Ctx.Extraction.CreateDate)</td>
                    <td data-label="Stand">@Ui.Pill("aktuell", "ok")</td>
                    <td class="mat-table__cell-actions"><div class="mat-table__actions">
                        @{ Preview("extracted", Model.PreviewUrl("extracted")); }
                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/files/@doc.Id/extracted.json" aria-label="Herunterladen" data-tip="Herunterladen">@Ui.Icon("download")</a>
                    </div></td>
                </tr>
            }
            @if (Model.Ctx.Revision is { } rev)
            {
                <tr class="@(Model.IsShown("normalized") ? "is-selected" : "")">
                    <td data-label="Datei">@Ui.NameWithSub("Normalisierte Daten", Model.PreviewUrl("normalized"), $"Revision {rev.Number}, {Model.Ctx.Report?.SchemaName} v{Model.Ctx.Report?.SchemaVersion}")</td>
                    <td data-label="Art" class="mat-hide-sm">JSON nach Zielschema (CSV und XML unter Exporte)</td>
                    <td data-label="Erzeugt" class="mat-hide-sm">@Fmt.Moment(rev.CreateDate)</td>
                    <td data-label="Stand">@Ui.Pill("aktuell", "ok")</td>
                    <td class="mat-table__cell-actions"><div class="mat-table__actions">
                        @{ Preview("normalized", Model.PreviewUrl("normalized")); }
                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/files/@doc.Id/normalized.json" aria-label="Herunterladen" data-tip="Herunterladen">@Ui.Icon("download")</a>
                    </div></td>
                </tr>
            }
            @if (Model.Ctx.Validation is { } val)
            {
                <tr class="@(Model.IsShown("report") ? "is-selected" : "")">
                    <td data-label="Datei">@Ui.NameWithSub("Validierungsbericht", Model.PreviewUrl("report"), $"{Labels.Of(val.Status)}: {val.Errors} Fehler, {val.Warnings} Warnungen")</td>
                    <td data-label="Art" class="mat-hide-sm">PDF oder JSON</td>
                    <td data-label="Erzeugt" class="mat-hide-sm">@Fmt.Moment(val.CreateDate)</td>
                    <td data-label="Stand">@Ui.Pill("aktuell", "ok")</td>
                    <td class="mat-table__cell-actions"><div class="mat-table__actions">
                        @{ Preview("report", Model.PreviewUrl("report")); }
                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/files/@doc.Id/report.pdf?download=1" aria-label="PDF herunterladen" data-tip="PDF">@Ui.Icon("file-text")</a>
                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/files/@doc.Id/report.json" aria-label="JSON herunterladen" data-tip="JSON">@Ui.Icon("file-code")</a>
                    </div></td>
                </tr>
            }
            @foreach (var f in Model.Ctx.Files)
            {
                var key = $"g{f.Id}";
                <tr class="@(Model.IsShown(key) ? "is-selected" : "")">
                    <td data-label="Datei">@Ui.NameWithSub(Labels.Of(f.Kind), Model.PreviewUrl(key), $"{f.StoredFile?.FileName} · {Fmt.FileSize(f.StoredFile?.SizeBytes ?? 0)}")</td>
                    <td data-label="Art" class="mat-hide-sm">@(f.Check ?? "erzeugt")</td>
                    <td data-label="Erzeugt" class="mat-hide-sm">@Fmt.Moment(f.CreateDate)</td>
                    <td data-label="Stand">@(Model.IsCurrent(f) ? Ui.Pill("aktuell", "ok") : Ui.Pill("ältere Daten", "warn"))</td>
                    <td class="mat-table__cell-actions"><div class="mat-table__actions">
                        @{ Preview(key, Model.PreviewUrl(key)); }
                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/files/generated/@f.Id?download=1" aria-label="Herunterladen" data-tip="Herunterladen">@Ui.Icon("download")</a>
                    </div></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Preview is { } p)
{
    <section class="mat-card" id="vorschau" aria-labelledby="preview-title">
        <div class="mat-card__head">@Ui.Icon(p.FrameUrl is null ? "file-code" : "file-text")<h2 class="mat-card__title" id="preview-title">Vorschau: @p.Title</h2>@if (p.Sub is not null) { <span class="mat-card__sub">@p.Sub</span> }</div>
        <div class="mat-card__body">
            @if (p.FrameUrl is not null)
            {
                <iframe class="im-frame" src="@p.FrameUrl" title="Vorschau: @p.Title"></iframe>
            }
            else
            {
                <pre class="im-code" tabindex="0" aria-label="Inhalt: @p.Title">@p.Text</pre>
            }
        </div>
    </section>
}

<form method="post" class="mat-form">
    <div class="mat-btn-row">
        @if (doc.XRechnungReady)
        {
            <button type="submit" asp-page-handler="XRechnung" asp-route-id="@doc.Id" asp-route-syntax="ubl" class="mat-btn mat-btn--primary">@Ui.Icon("file-code")<span>XRechnung (UBL)</span></button>
            <button type="submit" asp-page-handler="XRechnung" asp-route-id="@doc.Id" asp-route-syntax="cii" class="mat-btn mat-btn--secondary">@Ui.Icon("file-code")<span>XRechnung (CII)</span></button>
        }
        @if (doc.CurrentExtractionId is not null)
        {
            <button type="submit" asp-page-handler="Pdf" asp-route-id="@doc.Id" class="mat-btn mat-btn--secondary">@Ui.Icon("file-text")<span>PDF-Ansicht erzeugen</span></button>
        }
        <a class="mat-btn mat-btn--secondary" href="/Invoices/Details?id=@doc.Id">@Ui.Icon("back")<span>Zurück</span></a>
    </div>
</form>
@if (!doc.XRechnungReady && doc.ProcessingStatus == ProcessingStatus.Processed)
{
    <p class="mat-hint">Eine XRechnung ist nicht möglich: es fehlen Angaben oder sie widersprechen sich. Siehe <a href="/Invoices/Validation?id=@doc.Id#xrechnung">Validierung</a>.</p>
}
