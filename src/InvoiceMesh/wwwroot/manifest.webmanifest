{
  "name": "InvoiceMesh",
  "short_name": "InvoiceMesh",
  "description": "Internationale Rechnungen einlesen, normalisieren, prüfen und als XRechnung ausgeben.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "lang": "de",
  "dir": "ltr",
  "background_color": "#f5f4f1",
  "theme_color": "#f5f4f1",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Hochladen", "url": "/Invoices/Upload", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Belege", "url": "/Invoices", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
